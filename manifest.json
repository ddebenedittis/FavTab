{
  "manifest_version": 3,
  "name": "FavTab | Bookmarks New Tab Page",
  "version": "1.0.0",
  "description": "Replaces the new tab page with a grid of your bookmarks.",
  "permissions": ["bookmarks", "storage"],
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
